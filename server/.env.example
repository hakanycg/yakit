# Sunucu portu
PORT=4000

# Calisma ortami: development | production
NODE_ENV=development

# SQLite veritabani dosya yolu
DATABASE_PATH=./data/yakit.sqlite

# Oturum (session) cerezini imzalamak icin kullanilan gizli anahtar.
# Uretimde MUTLAKA rastgele, uzun (>=32 byte) bir deger ile degistirin:
#   openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_SECRET_BEFORE_DEPLOYING_TO_PRODUCTION

# Tarayicidan API'ye izin verilen kaynak (CORS)
WEB_ORIGIN=http://localhost:5173

# Cerezlerde Secure bayragi zorunlu kilinsin mi (HTTPS arkasinda calisirken true olmali)
COOKIE_SECURE=false

# Ilk kurulumda otomatik olusturulacak yonetici hesabi (yalnizca seed script'inde kullanilir)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!12345

# --- E-posta (SMTP) - makbuz ve kritik alarm bildirimleri icin ---
# Bos birakilirsa e-posta gonderimi devre disi kalir (hata vermez, sadece loglar).
# Ornek (Gmail uygulama sifresi ile): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yakit Istasyonu <no-reply@yakit-istasyonu.local>

# --- SMS - makbuz ve kritik alarm bildirimleri icin ---
# Genel bir HTTP tabanli SMS saglayicisina (Netgsm, Iletimerkezi, Twilio vb. -
# saglayicinizin REST endpoint'i) POST istegi atar. Bos birakilirsa SMS gonderimi
# devre disi kalir. Saglayicinizin istek formatina gore server/src/services/
# notificationService.ts icindeki sendSms fonksiyonunu uyarlamaniz gerekebilir.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=YAKITIST

# --- iyzico gercek odeme entegrasyonu ---
# Bu sunucunun disaridan (iyzico'nun sunuculari dahil) erisilebilir oldugu genel
# adres. iyzico odeme sonucu callback'i icin ZORUNLUDUR; "localhost" veya yerel
# ag adresleriyle CALISMAZ - yerelde test icin ngrok/cloudflared gibi bir tunel
# kullanip verdigi https adresi buraya yazmalisiniz. iyzico API anahtarlari ise
# .env'de degil, Yonetici Paneli > Ayarlar > "Odeme Ayarlari (iyzico)" ekranindan
# istasyon bazinda girilir (veritabaninda AES-256-GCM ile sifreli saklanir).
PUBLIC_API_BASE_URL=

# Veritabaninda saklanan iyzico/Uyumsoft sirlarini sifrelemek icin kullanilan anahtar.
# Bos birakilirsa SESSION_SECRET'tan turetilir (sifreleme yine de aktif olur) - ayri
# bir anahtar rotasyonu istiyorsaniz `openssl rand -hex 32` ile ayarlayabilirsiniz.
SETTINGS_ENCRYPTION_KEY=

# --- Otomatik veritabani yedeklemesi ---
# Bos birakilirsa (varsayilan) yedekleme kapali kalir. Ayarlanirsa, sunucu bu dizine
# periyodik olarak (BACKUP_INTERVAL_HOURS'ta bir) tutarli bir SQLite yedegi alir ve
# BACKUP_RETENTION_COUNT'tan eski yedekleri otomatik siler.
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
