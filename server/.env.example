# Sunucu portu
PORT=4000

# Calisma ortami: development | production
NODE_ENV=development

# SQLite veritabani dosya yolu
DATABASE_PATH=./data/yakit.sqlite

# Oturum (session) cerezini imzalamak icin kullanilan gizli anahtar.
# Uretimde MUTLAKA rastgele, uzun (>=32 byte) bir deger ile degistirin:
#   openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_SECRET_BEFORE_DEPLOYING_TO_PRODUCTION

# Tarayicidan API'ye izin verilen kaynak (CORS)
WEB_ORIGIN=http://localhost:5173

# Cerezlerde Secure bayragi zorunlu kilinsin mi (HTTPS arkasinda calisirken true olmali)
COOKIE_SECURE=false

# Ilk kurulumda otomatik olusturulacak yonetici hesabi (yalnizca seed script'inde kullanilir)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!12345
