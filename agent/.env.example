# Merkez sunucunun adresi (Railway/veri merkezi URL'i).
CENTRAL_API_URL=http://localhost:4000

# Admin panelinde "Ayarlar > Senkronizasyon" ekranindan bu istasyon icin
# uretilen paylasilan sir. ASLA kiosk tarayicisina veya versiyon kontrolune girmez.
STATION_SYNC_TOKEN=

# Ajanin yerel HTTP API'sinin dinleyecegi port (kiosk/pompa yazilimlari buraya baglanir).
PORT=4500

# Yerel outbox + onbellek verisinin tutuldugu SQLite dosyasi.
LOCAL_DB_PATH=./data/agent.sqlite

HEARTBEAT_INTERVAL_MS=60000
OUTBOX_FLUSH_INTERVAL_MS=15000
CACHE_PULL_INTERVAL_MS=120000
